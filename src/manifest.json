{
	"manifest_version": 3,
	"name": "Site-Specific Email Generator",
	"version": "1.0.1",
	"description": "Protect your real inbox by instantly generating and autofilling unique email addresses for every website using your personal domain.",
	"browser_specific_settings": {
		"gecko": {
			"id": "rouge.email-generator@eric-lowry.com",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		},
		"gecko_android": {}
	},
	"permissions": ["storage", "contextMenus", "activeTab", "scripting"],
	"web_accessible_resources": [
		{
			"resources": ["utils.js"],
			"matches": ["<all_urls>"]
		}
	],
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["main.js"]
		}
	],
	"action": {
		"default_title": "Site-Specific Email Generator",
		"default_popup": "popup/popup.html"
	},
	"background": {
		"scripts": ["background.js"],
		"type": "module"
	},
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": true
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	}
}
